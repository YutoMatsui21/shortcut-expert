{
  "name": "window-shortcut-coach",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Windows window-operation shortcut coach",
  "license": "UNLICENSED",
  "main": "out/main/index.cjs",
  "engines": { "node": ">=24.11.1 <25", "npm": ">=10" },
  "scripts": {
    "dev:check": "node scripts/dev-run.mjs check",
    "dev:install": "node scripts/dev-run.mjs npm-ci",
    "dev:electron": "node scripts/dev-run.mjs electron-install",
    "dev": "node scripts/dev-run.mjs electron-vite dev",
    "typecheck": "node scripts/dev-run.mjs tsc --noEmit",
    "test": "npm run test:unit && npm run test:native",
    "test:unit": "node scripts/test.mjs unit",
    "test:native": "npm run helper:build && node scripts/test.mjs native",
    "test:coverage": "node scripts/test.mjs unit --coverage",
    "helper:build": "node scripts/build-helper.mjs",
    "build": "npm run helper:build && npm run typecheck && node scripts/dev-run.mjs electron-vite build",
    "start": "node scripts/dev-run.mjs electron-vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:dev": "node scripts/dev-run.mjs electron-vite dev -- --coach-smoke",
    "package:dir": "node scripts/dev-run.mjs electron-builder --dir --win --x64",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "acceptance:storage": "node scripts/storage-acceptance.mjs",
    "probe:sqlite": "node scripts/sqlite-probe.mjs",
    "probe:sqlite:package": "node scripts/dev-run.mjs electron-builder --config validation/probes/sqlite/electron-builder.cjs --dir --win --x64",
    "probe:sqlite:packaged": "node scripts/sqlite-probe.mjs --packaged",
    "package:installer": "node scripts/dev-run.mjs electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  }
}
